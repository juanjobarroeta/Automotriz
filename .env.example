# URL del hub contabilidad-os (sin slash final).
# Vite hornea las env al build: cambiarla requiere redeploy con cache limpio.
VITE_API_URL=http://localhost:3000

# ── Sentry ───────────────────────────────────────────────────────────────────
# Sin DSN, todo el monitoreo es un no-op: el SPA corre igual sin cuenta.
# Una DSN solo permite ESCRIBIR eventos, por eso puede ir en el bundle.
# VITE_SENTRY_DSN="https://<key>@<org>.ingest.us.sentry.io/<project>"

# Muestreo de trazas: 0 apaga el tracing, 1 graba todo. Default 0.1 en build de
# producción, 0 en dev. OJO: con 0 se pierde la correlación con el hub — las
# trazas son lo que hace que un error de esta pantalla y la excepción del hub
# que lo causó aparezcan como UN solo hilo en Sentry.
# VITE_SENTRY_TRACES_SAMPLE_RATE="0.1"

# Nombre del ambiente en Sentry (default: production/development según el build).
# VITE_SENTRY_ENVIRONMENT="production"

# Session Replay (graba la pantalla cuando hay error). Apagado por omisión;
# al encenderlo el texto va enmascarado.
# VITE_SENTRY_REPLAY="1"

# Subida de source maps en el build. Sin el token el build NO falla: solo se
# salta la subida y los stack traces de producción quedan minificados (es decir,
# ilegibles para ti y para cualquier automatización que intente arreglarlos).
# Genera el token en Sentry → Settings → Auth Tokens, scope `project:releases`.
# SENTRY_AUTH_TOKEN="sntrys_..."
# SENTRY_ORG="cumplo-id"
# SENTRY_PROJECT="automotriz"
